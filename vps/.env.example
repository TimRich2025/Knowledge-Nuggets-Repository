KN_API_TOKEN=replace-with-a-long-random-token
KN_CALLBACK_TOKEN=
KN_YOUTUBE_UPLOAD_ENABLED=true
# One-time OAuth setup, then private uploads run without browser control.
KN_YOUTUBE_OAUTH_CLIENT_ID=
KN_YOUTUBE_OAUTH_CLIENT_SECRET=
KN_YOUTUBE_OAUTH_REFRESH_TOKEN=
KN_DATA_DIR=/data
KN_POLL_SECONDS=2
KN_MAX_CACHE_GB=80
